        "class": {
          "$ref": "#/$defs/classPath"
        }
      }
    },
    "unitCastEntry": {
      "description": "Added in 1.1. A character binding in one unit's sequence.",
      "type": "object",
      "required": [
        "character",
        "binding"
      ],
      "properties": {
        "character": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "minLength": 1,
          "description": "The binding's display name in the unit sequence."
        }
      }
    },
    "recorder": {
      "description": "Added in 1.1. What recorded a take.",
      "type": "string",
      "enum": [
        "take_recorder",
        "mocap_manager"
      ]
    },
    "capture": {
      "description": "Added in 1.1. One take that covered a line. A record of coverage only: the audio slot and its claims are unchanged.",
      "type": "object",
      "required": [
        "take",
        "slate",
        "number",
        "recorder",
        "time",
        "text_hash"
      ],
      "properties": {
        "take": {
          "$ref": "#/$defs/assetPath",
          "description": "The take's Level Sequence."
        },
        "slate": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "recorder": {
          "$ref": "#/$defs/recorder"
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC time the take finished, RFC 3339."
        },
        "text_hash": {
          "$ref": "#/$defs/sha256",
          "description": "The line's text_hash when the take was recorded."
        }
      }
    },
    "takeSequenceTags": {
      "title": "Tags on a recorded take's Level Sequence (added in 1.1)",
